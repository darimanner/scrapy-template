[project]
name = "{{ project_name }}"
version = "0.1.0"
description = {{ description | tojson }}
authors = [{ name = {{ author_name | tojson }}, email = {{ author_email | tojson }} }]
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
    "scrapy>=2.19.0",
]

[dependency-groups]
dev = [
    "pre-commit>=4.7.0",
    "pytest>=9.1.1",
    "ruff>=0.17.2",
]

[tool.pytest.ini_options]
pythonpath = ["."]
testpaths = ["tests"]

[tool.ruff]
line-length = 90

[tool.ruff.lint]
select = [
    "E",
    "F",
    "B",
    "I",
    "UP",
    "S",
    "C90",
    "N",
    "ANN",
    "ASYNC",
    "T20",
    "RUF",
    "PTH",
    "ERA",
    "PGH",
]
ignore = ["ANN401"]

[tool.ruff.lint.per-file-ignores]
"**/__init__.py" = ["F401"]
"src/spiders/**" = ["RUF012"]
"tests/**" = ["S101"]

[tool.ruff.lint.mccabe]
max-complexity = 8

[tool.ruff.lint.isort]
combine-as-imports = true
force-sort-within-sections = true
known-first-party = ["src"]
